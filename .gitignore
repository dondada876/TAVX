# TAV-X - Git Ignore Rules

# Environment & Secrets
.env
.env.*
!.env.example
*.env
*.key
*.pem
*.cert

# API Keys & Credentials
*credentials*.json
*secrets*.json
*api*keys*.txt
config/secrets/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
.npm
.yarn
dist/
build/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
ENV/
env/
*.egg-info/

# Databases
*.sql
*.sqlite
*.db
postgres-data/
redis-data/

# Logs
*.log
logs/
nohup.out

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Testing
coverage/
.nyc_output/
test-results/
playwright-report/

# Docker
.dockerignore
docker-compose.override.yml

# Terraform
*.tfstate
*.tfstate.*
.terraform/
*.tfvars
!example.tfvars

# Temporary files
tmp/
temp/
*.tmp
.cache/

# Mobile App
mobile-app/node_modules/
mobile-app/.expo/
mobile-app/.expo-shared/
mobile-app/ios/Pods/
mobile-app/android/.gradle/

# Build artifacts
*.zip
*.tar.gz
*.apk
*.ipa
*.dmg

# Media uploads (for local development only)
uploads/
media/
*.mp4
*.mp3
*.wav
