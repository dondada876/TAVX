# TAV-X Environment Configuration Template
# Copy this file to .env and fill in your actual values

# ===================================
# APPLICATION
# ===================================
NODE_ENV=development
APP_NAME=TAV-X
APP_URL=http://localhost:3000
API_PORT=3000
API_VERSION=v1

# ===================================
# DATABASE
# ===================================
# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tavx_db
POSTGRES_USER=tavx_user
POSTGRES_PASSWORD=your_secure_password_here

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# Airtable (MVP Phase)
AIRTABLE_API_KEY=your_airtable_api_key_here
AIRTABLE_BASE_ID=your_base_id_here

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your_qdrant_api_key_here

# ===================================
# AUTHENTICATION & SECURITY
# ===================================
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here
REFRESH_TOKEN_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# API Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===================================
# TESLA API
# ===================================
TESLA_CLIENT_ID=your_tesla_client_id
TESLA_CLIENT_SECRET=your_tesla_client_secret
TESLA_ACCESS_TOKEN=your_tesla_access_token
TESLA_REFRESH_TOKEN=your_tesla_refresh_token
TESLA_API_BASE_URL=https://owner-api.teslamotors.com

# ===================================
# VAPI (VOICE AI)
# ===================================
VAPI_API_KEY=your_vapi_api_key_here
VAPI_ASSISTANT_ID=your_checkin_assistant_id
VAPI_CHECKOUT_ASSISTANT_ID=your_checkout_assistant_id
VAPI_PHONE_NUMBER=+15105550199

# ===================================
# TWILIO (SMS/MMS)
# ===================================
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15105550199
TWILIO_VERIFY_SERVICE_SID=your_verify_service_sid

# ===================================
# STRIPE (PAYMENTS)
# ===================================
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_CONNECT_CLIENT_ID=ca_your_connect_client_id

# ===================================
# AWS
# ===================================
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=tavx-media-uploads
AWS_S3_REGION=us-west-2

# ===================================
# GOOGLE APIS
# ===================================
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
GOOGLE_CLOUD_VISION_API_KEY=your_vision_api_key
GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X

# ===================================
# VOICEMAP (TOURS)
# ===================================
VOICEMAP_API_KEY=your_voicemap_api_key
VOICEMAP_PUBLISHER_ID=your_publisher_id

# ===================================
# EMAIL
# ===================================
SENDGRID_API_KEY=your_sendgrid_api_key
EMAIL_FROM=noreply@tavx.com
EMAIL_SUPPORT=support@tavx.com

# ===================================
# MONITORING & ANALYTICS
# ===================================
SENTRY_DSN=https://your_sentry_dsn_here
MIXPANEL_TOKEN=your_mixpanel_token
PROMETHEUS_PORT=9090
GRAFANA_ADMIN_PASSWORD=your_grafana_password

# ===================================
# MESSAGE QUEUE
# ===================================
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_USER=tavx_user
RABBITMQ_PASSWORD=your_rabbitmq_password

# ===================================
# WORDPRESS INTEGRATION
# ===================================
WP_SITE_URL=https://tavx.com
WP_API_KEY=your_wordpress_api_key
WP_WEBHOOK_SECRET=your_webhook_secret

# ===================================
# N8N AUTOMATION
# ===================================
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook
N8N_API_KEY=your_n8n_api_key

# ===================================
# VTIGER CRM
# ===================================
VTIGER_URL=https://your-vtiger-instance.com
VTIGER_USERNAME=your_username
VTIGER_ACCESS_KEY=your_access_key

# ===================================
# SLACK (NOTIFICATIONS)
# ===================================
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_OPERATIONS_CHANNEL=#operations
SLACK_ALERTS_CHANNEL=#alerts

# ===================================
# DEVELOPMENT & DEBUGGING
# ===================================
DEBUG=tavx:*
LOG_LEVEL=debug
ENABLE_SWAGGER_UI=true
ENABLE_API_DOCS=true
